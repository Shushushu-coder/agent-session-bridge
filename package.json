{
  "name": "agent-session-bridge",
  "version": "0.4.0",
  "description": "Lightweight local MCP server bridging Codex main sessions to persistent Codex worker sessions.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "dist/index.js",
  "bin": {
    "agent-session-bridge": "dist/index.js",
    "agent-session-bridge-watch": "dist/watch/cli.js"
  },
  "files": [
    "dist"
  ],
  "mcpName": "io.github.shushushu-coder/agent-session-bridge",
  "scripts": {
    "dev": "npm run build:ui && tsx src/index.ts",
    "build": "npm run build:ui && tsc -p tsconfig.build.json",
    "build:ui": "node scripts/build-ui.mjs",
    "typecheck": "npm run build:ui && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.ui.json --noEmit",
    "test": "npm run build:ui && vitest run",
    "smoke": "npm run build && vitest run tests/mcp-smoke.test.ts",
    "watch": "tsx src/watch/cli.ts",
    "start": "node dist/index.js",
    "prepack": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "codex",
    "agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shushushu-coder/agent-session-bridge.git"
  },
  "bugs": "https://github.com/Shushushu-coder/agent-session-bridge/issues",
  "homepage": "https://github.com/Shushushu-coder/agent-session-bridge#readme",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^2.0.4",
    "@modelcontextprotocol/server": "^2.4.0",
    "@openai/codex-sdk": "^0.164.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
